{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Honeycomb Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/app/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/app/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "watch-vscode-extension",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://honeycomb-vscode/*": "${workspaceFolder}/app/vscode/*"
      }
    }
  ]
}